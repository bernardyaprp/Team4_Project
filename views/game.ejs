<%- include('partials/header') %>
  <%- include('partials/nav') %>

    <main class="page-container">

      <!-- Player information -->
      <section class="player-panel">

        <div class="player-message">

          <p class="eyebrow">
            Player Account
          </p>

          <h2 id="loginHeading">
            Play as a guest
          </h2>

          <p id="loginDescription">
            Log in or create an account to save your result to the leaderboard.
          </p>

        </div>

        <div id="guestActions" class="guest-actions">

          <a href="/login" class="primary-button account-link">
            Log In
          </a>

          <a href="/register" class="secondary-button account-link">
            Register
          </a>

        </div>

        <strong id="userStatus" class="player-name" hidden>
          Guest
        </strong>

      </section>


      <!-- Main game card -->
      <section class="game-card">

        <!-- Game heading -->
        <div class="game-card-heading">

          <div>

            <p class="eyebrow">
              TypeRush
            </p>

            <h1>
              Typing Test
            </h1>

          </div>

          <div class="game-actions">

            <button id="startBtn" class="primary-button" type="button">
              Start Game
            </button>

            <button id="restartBtn" class="secondary-button" type="button" disabled>
              Restart
            </button>

            <a href="/settings" class="secondary-button settings-link">
              Settings
            </a>

          </div>

        </div>


        <!-- Game Customisation Settings -->
        <section class="game-options">

          <!-- Time Selection -->
          <div class="option-section">

            <h3>
              Time
            </h3>

            <div class="option-buttons">

              <button class="option-button time-option" data-time="10">
                10s
              </button>

              <button class="option-button time-option active" data-time="20">
                20s
              </button>

              <button class="option-button time-option" data-time="30">
                30s
              </button>

              <button class="option-button time-option" data-time="45">
                45s
              </button>

              <button class="option-button time-option" data-time="60">
                60s
              </button>

            </div>

          </div>


          <!-- Word Count Selection -->
          <div class="option-section">

            <h3>
              Words
            </h3>

            <div class="option-buttons">

              <button class="option-button word-option" data-word="15">
                15
              </button>

              <button class="option-button word-option active" data-word="25">
                25
              </button>

              <button class="option-button word-option" data-word="35">
                35
              </button>

              <button class="option-button word-option" data-word="50">
                50
              </button>

            </div>

          </div>


          <!-- Feature Selection -->
          <div class="option-section">

            <h3>
              Features
            </h3>

            <div class="option-buttons">

              <button class="option-button feature-option" data-feature="punctuation">
                Punctuation
              </button>

              <button class="option-button feature-option" data-feature="numbers">
                Numbers
              </button>

              <button class="option-button feature-option" data-feature="caps">
                Caps
              </button>

            </div>

          </div>

        </section>


        <!-- Current game settings -->
        <section class="selected-settings">

          <div class="selected-setting">

            <span>
              Difficulty
            </span>

            <strong id="difficultyText">
              Normal
            </strong>

          </div>


          <div class="selected-setting">

            <span>
              Blind Mode
            </span>

            <strong id="blindModeText">
              Off
            </strong>

          </div>


          <div class="selected-setting">

            <span>
              Duration
            </span>

            <strong>
              <span id="durationText">20</span>s
            </strong>

          </div>

          <div class="selected-setting">
            <span>Words</span>
            <strong id="wordCountText">25</strong>
          </div>

        </section>

        <!-- Game statistics -->
        <section class="stats-grid">

          <div class="stat-card">

            <span>
              Time Left
            </span>

            <strong>
              <span id="timeText">
                20
              </span>s
            </strong>

          </div>


          <div class="stat-card">

            <span>
              Word Count
            </span>

            <strong id="currentWordCountText">
              0
            </strong>

          </div>


          <div class="stat-card">

            <span>
              WPM
            </span>

            <strong id="wpmText">
              0
            </strong>

          </div>


          <div class="stat-card">

            <span>
              Accuracy
            </span>

            <strong>
              <span id="accuracyText">
                100
              </span>%
            </strong>

          </div>

        </section>


        <!-- Game Status -->
        <div class="game-status">
          <span id="gameState">
            Ready
          </span>

          <span>
            •
          </span>

          <span id="modeDescription">
            Classic typing mode
          </span>
        </div>


        <!-- Word display -->
        <div id="wordBox" class="word-box" aria-live="polite">
          Press Start Game when you are ready.
        </div>


        <!-- Typing input -->
        <label for="typingInput" class="input-label">
          Type each word and press Space or Enter
        </label>

        <textarea id="typingInput" rows="3" placeholder="Press Start Game first..." autocomplete="off"
          autocapitalize="off" spellcheck="false" disabled></textarea>


        <!-- Feedback message -->
        <p id="messageText" class="game-message" aria-live="polite"></p>


      </section>

    </main>

    <script>

      // TYPE RUSH WORD LIST
      const words = [
        "apple", "window", "keyboard", "typing", "school",
        "browser", "planet", "coffee", "student", "holiday",
        "summer", "winter", "computer", "developer", "internet",
        "monitor", "website", "game", "player", "score",
        "speed", "accuracy", "challenge", "practice", "language",
        "garden", "village", "ocean", "music", "friend",
        "future", "project", "record", "leaderboard", "quick",
        "focus", "correct", "simple", "strong", "light",
        "dream", "travel", "learn", "create", "design",
        "coding", "javascript", "result", "normal", "expert",
        "master"
      ];


      // GAME SETTINGS
      let selectedDifficulty = "Normal";
      let selectedDuration = 20;
      let selectedWordCount = 25;

      let blindMode = "off";
      let minimumAccuracy = 0;

      let enablePunctuation = false;
      let enableNumbers = false;
      let enableCaps = false;


      // GAME VARIABLES
      let timeLeft = 20;
      let elapsedSeconds = 0;
      let timer = null;
      let running = false;
      let gameWords = [];
      let currentWordIndex = 0;
      let correctWords = 0;
      let incorrectWords = 0;
      let correctCharacters = 0;
      let incorrectCharacters = 0;

      // SAVE GAME SETTINGS
      function saveGameSettings() {

        localStorage.setItem(
          "typerush-game-duration",
          selectedDuration
        );

        localStorage.setItem(
          "typerush-game-wordCount",
          selectedWordCount
        );

        localStorage.setItem(
          "typerush-game-punctuation",
          enablePunctuation
        );

        localStorage.setItem(
          "typerush-game-numbers",
          enableNumbers
        );

        localStorage.setItem(
          "typerush-game-caps",
          enableCaps
        );

      }


      // HTML ELEMENTS
      const startBtn = document.getElementById("startBtn");
      const restartBtn = document.getElementById("restartBtn");
      const wordBox = document.getElementById("wordBox");
      const input = document.getElementById("typingInput");
      const timeText = document.getElementById("timeText");
      const durationText = document.getElementById("durationText");
      const wordCountText = document.getElementById("wordCountText");
      const currentWordCountText = document.getElementById("currentWordCountText");
      const wpmText = document.getElementById("wpmText");
      const accuracyText = document.getElementById("accuracyText");
      const difficultyText = document.getElementById("difficultyText");
      const blindModeText = document.getElementById("blindModeText");
      const gameState = document.getElementById("gameState");
      const modeDescription = document.getElementById("modeDescription");
      const message = document.getElementById("messageText");
      const userStatus = document.getElementById("userStatus");
      const loginHeading = document.getElementById("loginHeading");
      const loginDescription = document.getElementById("loginDescription");
      const guestActions = document.getElementById("guestActions");


      // USER LOGIN HANDLING
      function getLoggedInUser() {

        const username = localStorage.getItem("typerush-current-user");

        if (!username || username === "undefined") {
          return null;
        }
        return username.trim();
      }

      function loadUser() {

        const username = getLoggedInUser();

        if (username) {

          userStatus.textContent = username;
          userStatus.hidden = false;
          guestActions.hidden = true;
          loginHeading.textContent = "Hello, " + username + "!";
          loginDescription.textContent = "Your result will be saved to the leaderboard.";

        } else {

          userStatus.hidden = true;
          guestActions.hidden = false;
          loginHeading.textContent = "Play as a guest";
          loginDescription.textContent = "Log in or create an account to save your result to the leaderboard.";

        }

      }


      // LOAD GAME SETTINGS
      function loadGameSettings() {

        selectedDifficulty =
          localStorage.getItem(
            "typerush-setting-difficulty"
          ) || "normal";

        blindMode =
          localStorage.getItem(
            "typerush-setting-blindMode"
          ) || "off";

        selectedDifficulty = selectedDifficulty.charAt(0).toUpperCase() + selectedDifficulty.slice(1);

        difficultyText.textContent = selectedDifficulty;

        blindModeText.textContent =
          blindMode === "on"
            ? "On"
            : "Off";

        displayModeDescription();

        selectedDuration = Number(localStorage.getItem("typerush-game-duration")) || 20;
        selectedWordCount = Number(localStorage.getItem("typerush-game-wordCount")) || 25;
        enablePunctuation = localStorage.getItem("typerush-game-punctuation") === "true";
        enableNumbers = localStorage.getItem("typerush-game-numbers") === "true";
        enableCaps = localStorage.getItem("typerush-game-caps") === "true";
        durationText.textContent = selectedDuration;
        wordCountText.textContent = selectedWordCount;
        timeText.textContent = selectedDuration;

      }


      // DISPLAY MODE DESCRIPTION
      function displayModeDescription() {

        if (selectedDifficulty === "Expert") {
          modeDescription.textContent = "Incorrect submitted word ends the test";
        } else if (selectedDifficulty === "Master") {
          modeDescription.textContent = "Incorrect character ends the test immediately";
        } else {
          modeDescription.textContent = "Classic typing mode";
        }

        if (blindMode === "on") {

          modeDescription.textContent += " • Blind Mode";

        }

      }


      // GENERATE GAME WORDS
      function generateGameWords(amount = selectedWordCount) {

        const generatedWords = [];

        for (
          let index = 0;
          index < amount;
          index++
        ) {

          let randomWord =
            words[
            Math.floor(
              Math.random() * words.length
            )
            ];


          // Apply Caps
          if (enableCaps) {
            randomWord =
              randomWord.charAt(0).toUpperCase() +
              randomWord.slice(1);
          }

          // Apply Numbers
          if (enableNumbers) {

            const number =
              Math.floor(
                Math.random() * 10
              );

            randomWord += number;
          }

          // Apply Punctuation
          if (enablePunctuation) {

            const punctuationList = [
              "!",
              "?",
              ".",
              ","
            ];

            randomWord +=
              punctuationList[
              Math.floor(
                Math.random() *
                punctuationList.length
              )
              ];
          }

          generatedWords.push(randomWord);

        }
        return generatedWords;
      }


      // CREATE WORD ELEMENT
      function createWordElement(word, wordIndex) {

        const wordSpan = document.createElement("span");

        wordSpan.className = "typing-word";

        wordSpan.dataset.wordIndex = wordIndex;

        word.split("").forEach(function (character) {

          const characterSpan = document.createElement("span");

          characterSpan.textContent = character;

          characterSpan.className = "typing-character";

          wordSpan.appendChild(characterSpan);

        });


        if (wordIndex === currentWordIndex) {

          wordSpan.classList.add(
            "current-word"
          );

        }

        return wordSpan;

      }


      // DISPLAY WORDS
      function displayWords() {

        wordBox.innerHTML = "";

        const visibleWordCount = 6;

        const wordsToDisplay = Math.min(
          visibleWordCount,
          gameWords.length
        );

        for (
          let index = 0;
          index < wordsToDisplay;
          index++
        ) {

          const wordElement =
            createWordElement(
              gameWords[index],
              index
            );

          wordBox.appendChild(
            wordElement
          );
        }
      }

      // MASTER MODE CHECK
      function checkImmediateFailure() {

        const currentWord = gameWords[currentWordIndex];
        const typedWord = getCurrentTypedWord();

        if (
          typedWord.length === 0
        ) {
          return;
        }

        if (
          !currentWord.startsWith(typedWord)
        ) {

          endGame(true, "Master mode failed: incorrect character.");

        }
      }

      // START GAME
      function startGame() {

        clearInterval(timer);

        document
          .querySelectorAll(".option-button")
          .forEach(function (button) {
            button.disabled = true;
          });


        timeLeft = selectedDuration;
        elapsedSeconds = 0;
        currentWordIndex = 0;

        correctWords = 0;
        incorrectWords = 0;

        correctCharacters = 0;
        incorrectCharacters = 0;

        running = true;

        gameWords = generateGameWords(selectedWordCount);

        timeText.textContent = timeLeft;
        durationText.textContent = selectedDuration;
        timeText.textContent = selectedDuration;
        currentWordCountText.textContent = "0";
        wpmText.textContent = "0";
        accuracyText.textContent = "100";
        gameState.textContent = "In progress";
        message.textContent = "";

        startBtn.disabled = true;
        restartBtn.disabled = false;

        input.disabled = false;

        input.value = "";

        input.placeholder = "Start typing here...";

        displayWords();

        input.focus();

        timer = setInterval(function () {

          timeLeft--;
          elapsedSeconds++;

          timeText.textContent = timeLeft;

          updateStatistics();

          if (timeLeft <= 0) {

            endGame(
              false,
              "Time completed."
            );
          }

        }, 1000);
      }

      // INPUT HANDLING
      input.addEventListener(
        "input",
        function () {

          if (!running) {
            return;
          }

          input.value = input.value.replace(/\n/g, "");

          updateCharacterHighlighting();

          if (selectedDifficulty === "Master") {
            checkImmediateFailure();
          }
        }
      );

      // SUBMIT WORD
      input.addEventListener(
        "keydown",
        function (event) {

          if (!running) {
            return;
          }

          if (
            event.key !== " " &&
            event.key !== "Enter"
          ) {
            return;
          }

          event.preventDefault();

          submitCurrentWord();

        }
      );


      // GET CURRENT WORD
      function getCurrentTypedWord() {

        return input.value.trim();

      }


      // CHARACTER HIGHLIGHTING
      function updateCharacterHighlighting() {

        if (blindMode === "on") {
          return;
        }

        const currentWordElement = wordBox.querySelector(
          `[data-word-index="${currentWordIndex}"]`
        );


        if (!currentWordElement) {
          return;
        }

        const correctWord = gameWords[currentWordIndex];
        const typedWord = getCurrentTypedWord();
        const characters = currentWordElement.querySelectorAll(
          ".typing-character"
        );

        characters.forEach(
          function (character, index) {

            character.classList.remove(
              "correct-character",
              "incorrect-character"
            );

            if (index >= typedWord.length) {
              return;
            }

            if (
              typedWord[index] === correctWord[index]
            ) {

              character.classList.add(
                "correct-character"
              );

            } else {

              character.classList.add(
                "incorrect-character"
              );
            }
          }
        );
      }


      // SUBMIT CURRENT WORD
      function submitCurrentWord() {

        const typedWord = getCurrentTypedWord();

        if (typedWord === "") {
          return;
        }

        const correctWord = gameWords[currentWordIndex];

        const wordElement = wordBox.querySelector(
          `[data-word-index="${currentWordIndex}"]`
        );

        if (!wordElement) {
          return;
        }

        countCharacters(
          typedWord,
          correctWord
        );

        if (typedWord === correctWord) {

          correctWords++;

          wordElement.classList.add(
            "completed-correct-word"
          );

          message.textContent = "Correct!";

          message.className = "game-message correct-message";

        } else {

          incorrectWords++;

          wordElement.classList.add(
            "completed-incorrect-word"
          );

          message.textContent = "Incorrect. The correct word was \"" + correctWord + "\".";

          message.className = "game-message incorrect-message";

          if (selectedDifficulty === "Expert") {

            endGame(
              true,
              "Expert mode failed: incorrect word."
            );

            return;
          }
        }


        wordElement.classList.remove(
          "current-word"
        );

        currentWordIndex++;

        if (
          currentWordIndex >= gameWords.length
        ) {

          gameWords.push(
            ...generateGameWords(selectedWordCount)
          );

        }

        const nextWord = wordBox.querySelector(
          `[data-word-index="${currentWordIndex}"]`
        );

        if (nextWord) {
          nextWord.classList.add(
            "current-word"
          );
        }

        appendNextWord();

        input.value = "";

        updateStatistics();
      }


      // ADD NEXT WORD
      function appendNextWord() {

        const displayedWords =
          wordBox.querySelectorAll(
            ".typing-word"
          );

        if (displayedWords.length === 0) {
          return;
        }

        const lastWord =
          displayedWords[
          displayedWords.length - 1
          ];


        const nextIndex =
          Number(
            lastWord.dataset.wordIndex
          ) + 1;


        if (
          nextIndex >= gameWords.length
        ) {

          gameWords.push(
            ...generateGameWords(selectedWordCount)
          );

        }

        const nextWordElement =
          createWordElement(
            gameWords[nextIndex],
            nextIndex
          );

        wordBox.appendChild(
          nextWordElement
        );

        nextWordElement.scrollIntoView({
          behavior: "smooth",
          block: "center"
        });

      }

      // COUNT CHARACTERS
      function countCharacters(
        typedWord,
        correctWord
      ) {

        const length =
          Math.max(
            typedWord.length,
            correctWord.length
          );

        for (
          let index = 0;
          index < length;
          index++
        ) {

          if (
            typedWord[index] === correctWord[index]
          ) {

            correctCharacters++;

          } else {

            incorrectCharacters++;

          }
        }
      }

      // UPDATE STATISTICS
      function updateStatistics() {

        const totalCharacters = correctCharacters + incorrectCharacters;

        const accuracy =
          totalCharacters === 0
            ? 100
            : Math.round(
              correctCharacters /
              totalCharacters *
              100
            );

        const minutes = elapsedSeconds / 60;

        const wpm =
          minutes === 0
            ? 0
            : Math.round(
              correctCharacters /
              5 /
              minutes
            );

        currentWordCountText.textContent = correctWords + incorrectWords;
        accuracyText.textContent = accuracy;

        wpmText.textContent =
          Math.max(
            0,
            wpm
          );
      }


      // END GAME
      function endGame(
        failed,
        reason
      ) {

        clearInterval(timer);

        running = false;

        document
          .querySelectorAll(".option-button")
          .forEach(function (button) {

            button.disabled = false;

          });

        input.disabled = true;

        startBtn.disabled = false;
        restartBtn.disabled = false;

        updateStatistics();

        const finalAccuracy = Number(accuracyText.textContent);

        if (
          finalAccuracy < minimumAccuracy
        ) {

          failed = true;
          reason = "Minimum accuracy requirement not reached.";

        }

        gameState.textContent =
          failed
            ? "Failed"
            : "Finished";

        message.textContent = reason;

        const result = {

          username:
            getLoggedInUser() ||
            "Guest",

          score:
            Math.max(
              0,
              correctWords * 10 -
              incorrectWords * 5
            ),

          wpm:
            Number(
              wpmText.textContent
            ),

          accuracy:
            Number(
              accuracyText.textContent
            ),

          correctWords: correctWords,
          totalWords: correctWords + incorrectWords,
          difficulty: selectedDifficulty,
          duration: selectedDuration,
          failed: failed

        };


        sessionStorage.setItem(
          "latestGameResult",
          JSON.stringify(result)
        );

        saveScore(result);

        setTimeout(
          function () {

            window.location.href = "/result";

          },
          1000
        );
      }


      // SAVE SCORE TO LEADERBOARD
      async function saveScore(result) {

        const username = getLoggedInUser();

        if (!username) {
          return;
        }

        if (
          result.duration !== 20 &&
          result.duration !== 30
        ) {
          return;
        }


        try {

          await fetch("/api/leaderboard", {
            method: "POST",
            headers: { "Content-Type": "application/json" },

            body: JSON.stringify({
              username: username,
              score: result.score,
              wpm: result.wpm,
              accuracy: result.accuracy,
              timeLimit: result.duration,
              difficulty: result.difficulty
            })
          });

        } catch (error) {

          console.error(
            "Failed to save score:",
            error
          );
        }
      }


      // GAME OPTION BUTTONS
      document
        .querySelectorAll(".time-option")
        .forEach((button) => {

          button.addEventListener(
            "click",
            function () {

              selectedDuration = Number(this.dataset.time);

              document
                .querySelectorAll(".time-option")
                .forEach(btn =>
                  btn.classList.remove("active")
                );

              this.classList.add("active");

              durationText.textContent = selectedDuration;
              timeText.textContent = selectedDuration;

              saveGameSettings();
            }
          );
        });

      document.querySelectorAll(".word-option")
        .forEach(function (button) {

          button.addEventListener(
            "click",
            function () {

              document
                .querySelectorAll(".word-option")
                .forEach(
                  btn =>
                    btn.classList.remove("active")
                );


              this.classList.add("active");

              selectedWordCount = Number(this.dataset.word);
              wordCountText.textContent = selectedWordCount;

              saveGameSettings();

            }
          );

        });


      document.querySelectorAll(".feature-option")
        .forEach(function (button) {

          button.addEventListener(
            "click",
            function () {

              if (running) {
                return;
              }

              this.classList.toggle("active");

              const feature = this.dataset.feature;

              if (feature === "punctuation") {
                enablePunctuation = this.classList.contains("active");
              }

              if (feature === "numbers") {
                enableNumbers = this.classList.contains("active");
              }

              if (feature === "caps") {
                enableCaps = this.classList.contains("active");
              }
              saveGameSettings();
            }
          );
        });



      // RESTORE BUTTON STATES
      function restoreButtonStates() {

        document
          .querySelectorAll(".time-option")
          .forEach(function (button) {

            button.classList.toggle(
              "active",
              Number(button.dataset.time) === selectedDuration
            );

          });


        document
          .querySelectorAll(".word-option")
          .forEach(function (button) {

            button.classList.toggle(
              "active",
              Number(button.dataset.word) === selectedWordCount
            );

          });


        document
          .querySelectorAll(".feature-option")
          .forEach(function (button) {

            const feature =
              button.dataset.feature;


            button.classList.toggle(
              "active",
              (feature === "punctuation" && enablePunctuation) ||
              (feature === "numbers" && enableNumbers) ||
              (feature === "caps" && enableCaps)
            );

          });

      }


      // BUTTON CONNECTIONS
      startBtn.addEventListener(
        "click",
        startGame
      );


      restartBtn.addEventListener(
        "click",
        startGame
      );


      // PAGE STARTUP
      loadUser();
      loadGameSettings();
      restoreButtonStates();

    </script>

    <%- include('partials/footer') %>