<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TypeRush - Register</title>
  <link rel="stylesheet" href="css/game.css">
</head>
<body>
  <nav class="navbar">
    <a href="/" class="logo-link">
      <div class="logo">
        <img src="/images/TypeRush.jpg" alt="TypeRush logo" class="site-logo">
        <h1>TypeRush</h1>
      </div>
    </a>

    <div class="nav-links">
      <a href="/leaderboard">Leaderboard</a>
      <a href="/settings">Settings</a>
    </div>
  </nav>

  <main class="container auth-container">
    <div class="card auth-card">
      <h2>Create an account</h2>
      <p>Register with a username and password so you can log in again later.</p>

      <div id="authMessage" class="auth-message"></div>

      <form class="auth-form" id="registerForm">
        <label for="username">Username</label>
        <input id="username" name="username" type="text" placeholder="Choose a username" required>

        <label for="password">Password</label>
        <input id="password" name="password" type="password" placeholder="Choose a password" required>

        <button type="submit">Register</button>
      </form>

      <p class="auth-switch">
        Already have an account? <a href="/login">Login here</a>
      </p>
    </div>
  </main>

  <script>
    const form = document.getElementById('registerForm');
    const messageBox = document.getElementById('authMessage');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const username = document.getElementById('username').value.trim();
      const password = document.getElementById('password').value.trim();

      if (!username || !password) {
        messageBox.textContent = 'Please enter both username and password.';
        messageBox.className = 'auth-message error';
        return;
      }

      try {
        const response = await fetch('/api/register', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ username, password })
        });

        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.message || 'Registration failed.');
        }

        messageBox.textContent = 'Account created. Redirecting to login...';
        messageBox.className = 'auth-message success';

        setTimeout(() => {
          window.location.href = '/login?registered=1';
        }, 800);

      } catch (error) {
        messageBox.textContent = error.message;
        messageBox.className = 'auth-message error';
      }
    });
  </script>
</body>
</html>