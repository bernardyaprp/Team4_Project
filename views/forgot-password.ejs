<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TypeRush - Forgot Password</title>
  <link rel="stylesheet" href="css/game.css">
</head>
<body>
  <%- include('partials/nav') %>

  <main class="container auth-container">
    <div class="card auth-card">
      <h2>Reset your password</h2>
      <p>Enter your username and we'll send password reset instructions.</p>

      <div id="authMessage" class="auth-message"></div>

      <form class="auth-form" id="forgotPasswordForm">
        <label for="username">Username</label>
        <input id="username" name="username" type="text" placeholder="Enter your username" required>

        <button type="submit">Send reset link</button>
      </form>

      <p class="auth-switch">
        Remembered your password? <a href="/login">Login here</a>
      </p>
    </div>
  </main>

  <script>
    const form = document.getElementById('forgotPasswordForm');
    const messageBox = document.getElementById('authMessage');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const username = document.getElementById('username').value.trim();

      if (!username) {
        messageBox.textContent = 'Please enter your username.';
        messageBox.className = 'auth-message error';
        return;
      }

      try {
        const response = await fetch('/api/forgot-password', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ username })
        });

        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.message || 'Request failed.');
        }

        if (result.resetUrl) {
          messageBox.innerHTML = `${result.message} <a href="${result.resetUrl}">Click here to reset your password</a>.`;
        } else {
          messageBox.textContent = result.message || 'Reset instructions have been generated.';
        }
        messageBox.className = 'auth-message success';
      } catch (error) {
        messageBox.textContent = error.message;
        messageBox.className = 'auth-message error';
      }
    });
  </script>
</body>
</html>
